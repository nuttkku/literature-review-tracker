{
  "name": "literature-review-tracker",
  "version": "1.0.0",
  "description": "Self-hosted web app for tracking a literature review: papers by domain, coverage against targets, gap analysis, citation templates, and rejected papers.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:server": "node --env-file=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview --host",
    "start": "node server/index.js",
    "test": "node scripts/smoke-test.mjs",
    "security:scan": "snyk test --severity-threshold=high && snyk code test --severity-threshold=high",
    "test:ui": "node scripts/ui-test.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.0",
    "helmet": "^8.3.0",
    "html-to-image": "^1.11.13",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "svelte": "^5.57.1",
    "write-excel-file": "^4.1.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
